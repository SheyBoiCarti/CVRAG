# =====================================================================
# AI Portfolio Knowledge Base // Environment Configuration Template
# Local development only. Use platform secrets in production deployment.
# =====================================================================

# ---------------------------------------------------------------------
# NVIDIA NIM / AI Foundation API Credentials & Model Selection
# ---------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
LLM_MODEL=meta/llama-3.3-70b-instruct

# ---------------------------------------------------------------------
# Document Ingestion & Vector Storage Paths
# ---------------------------------------------------------------------
DOCUMENTS_DIR=./documents
VECTOR_DB_DIR=./vector_db

# ---------------------------------------------------------------------
# Text Splitting & Retrieval Tuning
# ---------------------------------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=140
RETRIEVAL_K=6
MAX_QUESTION_CHARS=1000
MAX_HISTORY_TURNS=4

# ---------------------------------------------------------------------
# Resiliency & Performance Limits
# ---------------------------------------------------------------------
REQUEST_TIMEOUT=45
MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=15

# ---------------------------------------------------------------------
# FastAPI Backend & CORS Settings
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. http://localhost:3000,http://localhost:5173).
# Wildcards are disallowed. Empty string disables CORS headers.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
API_CORS_ALLOW_CREDENTIALS=false
API_MAX_BODY_BYTES=32768
API_MAX_CONCURRENT_GENERATIONS=4

# ---------------------------------------------------------------------
# Pipeline & Index Schema Identifiers
# ---------------------------------------------------------------------
PIPELINE_VERSION=dense-v1
INDEX_SCHEMA_VERSION=v3
