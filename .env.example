# =====================================================================
# AI Portfolio Knowledge Base // Environment Configuration Template
# Local development only. Use platform secrets in production deployment.
# =====================================================================

# ---------------------------------------------------------------------
# NVIDIA NIM / AI Foundation API Credentials & Model Selection
# ---------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
PROVIDER_MODE=live
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
LLM_MODEL=meta/llama-3.3-70b-instruct

# ---------------------------------------------------------------------
# Document Ingestion & Vector Storage Paths
# ---------------------------------------------------------------------
DOCUMENTS_DIR=./documents
VECTOR_DB_DIR=./vector_db

# ---------------------------------------------------------------------
# Chunking Strategies & Ingestion Tuning
# ---------------------------------------------------------------------
CHUNK_STRATEGY=recursive_bullet_v1
CHUNK_SIZE=700
CHUNK_OVERLAP=140
SEMANTIC_BREAK_THRESHOLD=0.35
SEMANTIC_MIN_CHARS=200
SEMANTIC_MAX_CHARS=900
SEMANTIC_OVERLAP_UNITS=1
STRUCTURE_MAX_CHARS=700
STRUCTURE_OVERLAP_CHARS=140
RETRIEVAL_K=6
RETRIEVAL_MODE=dense
DENSE_CANDIDATE_K=20
SPARSE_CANDIDATE_K=20
FUSION_CANDIDATE_K=20
CONTEXT_K=6
RRF_CONSTANT=60
DENSE_RRF_WEIGHT=1.0
SPARSE_RRF_WEIGHT=1.0
RERANK_ENABLED=false
RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
RERANK_CANDIDATE_K=20
MAX_QUESTION_CHARS=1000
MAX_HISTORY_TURNS=4

# ---------------------------------------------------------------------
# Citation Verification & Answerability Policy
# ---------------------------------------------------------------------
VERIFIER_ENABLED=true
VERIFIER_FAIL_CLOSED=true
ANSWERABILITY_CALIBRATION_FILE=
MAX_CORRECTION_ATTEMPTS=1

# ---------------------------------------------------------------------
# Resiliency & Performance Limits
# ---------------------------------------------------------------------
REQUEST_TIMEOUT=45
MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=15

# ---------------------------------------------------------------------
# FastAPI Backend & CORS Settings
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins (e.g. http://localhost:3000,http://localhost:8501).
# Wildcards are disallowed. Empty string disables CORS headers.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501
API_CORS_ALLOW_CREDENTIALS=false
API_MAX_BODY_BYTES=32768
API_MAX_CONCURRENT_GENERATIONS=4

# ---------------------------------------------------------------------
# Pipeline & Index Schema Identifiers
# ---------------------------------------------------------------------
PIPELINE_VERSION=dense-v1
INDEX_SCHEMA_VERSION=v3

# ---------------------------------------------------------------------
# Next.js Frontend Configuration (Server-Only Runtime Proxy)
# ---------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
