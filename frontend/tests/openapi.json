ersational question answering queries."}, "ChatResponse": {"properties": {"answer": {"type": "string", "title": "Answer"}, "citations": {"items": {"$ref": "#/components/schemas/CitationSchema"}, "type": "array", "title": "Citations"}, "claim_verifications": {"items": {"$ref": "#/components/schemas/ClaimVerificationSchema"}, "type": "array", "title": "Claim Verifications"}, "decision": {"type": "string", "enum": ["answered", "abstained", "degraded"], "title": "Decision", "default": "answered"}, "reason_codes": {"items": {"type": "string"}, "type": "array", "title": "Reason Codes"}, "retrieval_query": {"type": "string", "title": "Retrieval Query", "default": ""}, "pipeline_version": {"type": "string", "title": "Pipeline Version", "default": ""}}, "type": "object", "required": ["answer"], "title": "ChatResponse", "description": "Structured response payload for synchronous chat queries."}, "ChatTurnSchema": {"properties": {"user": {"type": "string", "title": "User"}, "assistant": {"type": "string", "title": "Assistant"}}, "type": "object", "required": ["user", "assistant"], "title": "ChatTurnSchema", "description": "Conversational turn between user and assistant."}, "CitationSchema": {"properties": {"evidence_id": {"type": "string", "title": "Evidence Id"}, "chunk_id": {"type": "string", "title": "Chunk Id"}, "source": {"type": "string", "title": "Source"}, "page": {"type": "integer", "title": "Page"}, "excerpt": {"type": "string", "title": "Excerpt"}, "support_status": {"type": "string", "enum": ["supported", "unsupported", "not_checked"], "title": "Support Status", "default": "not_checked"}}, "type": "object", "required": ["evidence_id", "chunk_id", "source", "page", "excerpt"], "title": "CitationSchema", "description": "Attribution reference for generated answer assertions."}, "ClaimVerificationSchema": {"properties": {"claim_id": {"type": "string", "title": "Claim Id"}, "text": {"type": "string", "title": "Text"}, "factual": {"type": "boolean", "title": "Factual", "