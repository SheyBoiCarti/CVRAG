{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt; (cd frontend && npm install); echo '✅ Packages installed and Requirements met'",
  "portsAttributes": {
    "3000": {
      "label": "Next.js Frontend",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "silent"
    },
    "8501": {
      "label": "Streamlit (Legacy)",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    3000,
    8000,
    8501
  ]
}